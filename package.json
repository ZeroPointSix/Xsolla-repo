{
  "name": "ai-repo-inspector-assessment-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A repository review tool with CLI and MCP interfaces.",
  "files": [
    "dist"
  ],
  "bin": {
    "inspector": "./dist/cli.js"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "inspector": "tsx src/cli.ts",
    "mcp-server": "tsx src/mcp-server.ts",
    "smoke:installed-cli": "node scripts/smoke-installed-cli.mjs",
    "smoke:compiled-mcp": "node scripts/smoke-compiled-mcp.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "eslint": "^9.39.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  }
}
